+#[cfg(test)]
+mod tests {
+    use super::last_agreed_height;
+    use std::cell::Cell;
+
+    /// Agreement up to and including `last`, nothing above: the shape every real comparison has.
+    fn agree_to(last: usize, asked: &Cell<usize>) -> impl FnMut(usize) -> anyhow::Result<bool> + '_ {
+        move |height| {
+            asked.set(asked.get() + 1);
+            Ok(height <= last)
+        }
+    }
+
+    /// The usual startup: the node has the indexed tip, and finding that out costs one call.
+    #[test]
+    fn a_node_that_has_the_tip_costs_one_call() {
+        let asked = Cell::new(0);
+        assert_eq!(last_agreed_height(973_996, agree_to(973_996, &asked)).unwrap(), 973_996);
+        assert_eq!(asked.get(), 1, "only the tip was asked about");
+    }
+
+    /// Switched to the other side of the fork: agreement ends at the last shared block.
+    #[test]
+    fn a_switch_across_the_fork_lands_on_the_last_shared_block() {
+        let asked = Cell::new(0);
+        assert_eq!(last_agreed_height(967_822, agree_to(961_631, &asked)).unwrap(), 961_631);
+        assert!(asked.get() <= 22, "a binary search, not a walk: {} calls", asked.get());
+    }
+
+    /// The case `getheaders` gets wrong on its own: a node that is behind the index, whether on
+    /// the same chain or stuck below the split on the other one. Agreement ends at the node's tip.
+    #[test]
+    fn a_node_behind_the_index_lands_on_the_node_tip() {
+        let asked = Cell::new(0);
+        assert_eq!(last_agreed_height(967_822, agree_to(500_000, &asked)).unwrap(), 500_000);
+    }
+
+    /// Nothing shared but genesis, which is taken as agreed rather than asked about.
+    #[test]
+    fn nothing_shared_but_genesis_lands_on_genesis() {
+        let asked = Cell::new(0);
+        let mut probe = agree_to(0, &asked);
+        let got = last_agreed_height(1_000, |h| {
+            assert_ne!(h, 0, "genesis is never asked about");
+            probe(h)
+        })
+        .unwrap();
+        assert_eq!(got, 0);
+    }
+
+    /// Every boundary lands exactly, including the edges beside genesis and the tip, which is
+    /// where an off-by-one in a binary search lives.
+    #[test]
+    fn every_boundary_is_found_exactly() {
+        for tip in 1..70usize {
+            for last in 0..=tip {
+                let asked = Cell::new(0);
+                assert_eq!(
+                    last_agreed_height(tip, agree_to(last, &asked)).unwrap(),
+                    last,
+                    "tip {} agreeing to {}",
+                    tip,
+                    last
+                );
+            }
+        }
+    }
+
+    /// A failed call to the node is an error, not a guess. Treating it as disagreement would trim
+    /// a good index back to wherever the search happened to be.
+    #[test]
+    fn a_failed_call_is_an_error_not_a_disagreement() {
+        let err = last_agreed_height(100, |h| {
+            if h == 100 {
+                Ok(false)
+            } else {
+                anyhow::bail!("node unreachable")
+            }
+        })
+        .unwrap_err();
+        assert!(format!("{:#}", err).contains("node unreachable"));
+    }
+}
