+/// The highest height at or below `tip` where the index and the node agree.
+///
+/// `agrees(height)` must be monotone -- true from genesis up to some height, false above it --
+/// which holds for block hashes because each commits to its ancestors. Genesis is taken as agreed
+/// rather than asked about: it is fixed per network, and electrs keeps a separate database per
+/// network, so there is nothing to learn from asking.
+///
+/// Asks about the tip first, so a node that already has it costs one call. Otherwise a binary
+/// search, about twenty calls for a mainnet-sized chain.
+fn last_agreed_height(tip: usize, mut agrees: impl FnMut(usize) -> Result<bool>) -> Result<usize> {
+    if agrees(tip)? {
+        return Ok(tip);
+    }
+    // Invariant: agrees(lo) and !agrees(hi).
+    let (mut lo, mut hi) = (0, tip);
+    while hi - lo > 1 {
+        let mid = lo + (hi - lo) / 2;
+        if agrees(mid)? {
+            lo = mid;
+        } else {
+            hi = mid;
+        }
+    }
+    Ok(lo)
+}
