+    /// The hash of the block at `height` on the node's active chain, or `None` above its tip.
+    ///
+    /// `getblockhash` answers from the header chain, so a pruned node answers it for any height,
+    /// and it returns a bare string: nothing here for a changed RPC shape to break.
+    pub(crate) fn get_block_hash_at(&self, height: usize) -> Result<Option<BlockHash>> {
+        match self.rpc.get().get_block_hash(height as u64) {
+            Ok(hash) => Ok(Some(hash)),
+            Err(err) => match extract_bitcoind_error(&err) {
+                // RPC_INVALID_PARAMETER, "Block height out of range": above the node's tip.
+                Some(e) if e.code == -8 => Ok(None),
+                _ => Err(err).with_context(|| format!("failed to get block hash at {}", height)),
+            },
+        }
+    }
