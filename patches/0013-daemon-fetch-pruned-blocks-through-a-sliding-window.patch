+/// Run `fetch` over `items` with at most `concurrency` of them in flight, handing each result to
+/// `deliver` in the order the items were given.
+///
+/// Written as a window rather than as fixed batches, which is the difference between this and an
+/// earlier version that had to be reverted. Fetching `N`, waiting for all `N`, then starting the
+/// next `N` costs the slowest item in each batch rather than the average, because the other
+/// workers sit idle at the barrier. Here a worker is started the moment the window's head is
+/// delivered, so the workers stay fed however long any one item takes.
+///
+/// Delivery is sequential, in order, and exactly once per item, because callers depend on all
+/// three. `Index::index_blocks` is the sharp case: it walks a separate iterator of heights, taking
+/// the next one per delivered block, so a reordering there would index blocks at each other's
+/// heights. Nothing would catch it -- its `expect` only fires on too many blocks and its `assert`
+/// only on too few -- and the result would be a silently wrong index. `Tracker::lookup_transaction`
+/// likewise keeps the first match for a BIP-30 duplicate txid, which is only meaningful in order.
+///
+/// A slow item therefore delays delivery of everything behind it, which is unavoidable when order
+/// is required, but it does not stop those fetches from having already run.
+///
+/// The first error in item order is returned, and the fetches already in flight are waited out
+/// rather than abandoned; there is no way to cancel a blocking RPC mid-call.
+fn pipeline<T, R, F, D>(items: &[T], concurrency: usize, fetch: F, mut deliver: D) -> Result<()>
+where
+    T: Sync,
+    R: Send,
+    F: Fn(usize, &T) -> Result<R> + Sync,
+    D: FnMut(&T, R) -> Result<()>,
+{
+    assert!(concurrency > 0, "a pipeline with no workers cannot progress");
+
+    std::thread::scope(|scope| -> Result<()> {
+        let mut window: VecDeque<mpsc::Receiver<Result<R>>> = VecDeque::with_capacity(concurrency);
+        let mut queued = 0usize;
+
+        for (i, item) in items.iter().enumerate() {
+            // Top the window back up before waiting on its head, so the wait is spent with the
+            // other workers running rather than idle.
+            while queued < items.len() && window.len() < concurrency {
+                let (tx, rx) = mpsc::sync_channel(1);
+                let at = queued;
+                let fetch = &fetch;
+                scope.spawn(move || {
+                    // Ignore a send error: it only means the receiver was dropped because an
+                    // earlier item already failed and the run is unwinding.
+                    let _ = tx.send(fetch(at, &items[at]));
+                });
+                window.push_back(rx);
+                queued += 1;
+            }
+
+            let value = window
+                .pop_front()
+                .expect("one fetch is queued for every item not yet delivered")
+                .recv()
+                .expect("a pipeline worker panicked")?;
+            deliver(item, value)?;
+            debug_assert!(queued > i);
+        }
+        Ok(())
+    })
+}
