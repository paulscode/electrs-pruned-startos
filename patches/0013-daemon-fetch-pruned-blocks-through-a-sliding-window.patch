+    /// Delivery follows the request order whatever order the fetches finish in, and no more
+    /// than `concurrency` run at once. Both matter: callers accumulate state through `deliver`,
+    /// and the bound is what keeps a run of thousands of megabyte blocks from being held at once.
+    #[test]
+    fn the_window_delivers_in_order_and_keeps_a_bounded_number_in_flight() {
+        use std::sync::atomic::{AtomicUsize, Ordering};
+        use std::time::Duration;
+
+        const CONCURRENCY: usize = 4;
+        let items: Vec<usize> = (0..32).collect();
+        let in_flight = AtomicUsize::new(0);
+        let high_water = AtomicUsize::new(0);
+        let mut delivered = vec![];
+
+        super::pipeline(
+            &items,
+            CONCURRENCY,
+            |_, &item| {
+                let now = in_flight.fetch_add(1, Ordering::SeqCst) + 1;
+                high_water.fetch_max(now, Ordering::SeqCst);
+                // Long enough that genuinely concurrent workers overlap here.
+                std::thread::sleep(Duration::from_millis(5));
+                in_flight.fetch_sub(1, Ordering::SeqCst);
+                Ok(item)
+            },
+            |_, item| {
+                delivered.push(item);
+                Ok(())
+            },
+        )
+        .unwrap();
+
+        assert_eq!(delivered, items, "delivery follows request, not completion");
+        let peak = high_water.load(Ordering::SeqCst);
+        assert!(peak > 1, "nothing ever ran concurrently");
+        assert!(peak <= CONCURRENCY, "{} in flight, over the bound", peak);
+    }
+
+    /// The shapes a run can actually arrive in. `for_blocks_with` slices its batch into runs of
+    /// same-availability blocks, so a run of one, or one shorter than the window, is ordinary
+    /// rather than exotic -- and an empty slice must not spawn anything or hang waiting on it.
+    #[test]
+    fn the_window_handles_runs_of_any_length() {
+        for len in 0..(super::FETCH_CONCURRENCY * 2 + 1) {
+            for concurrency in 1..=(super::FETCH_CONCURRENCY + 2) {
+                let items: Vec<usize> = (0..len).collect();
+                let mut delivered = vec![];
+                super::pipeline(
+                    &items,
+                    concurrency,
+                    |i, &item| {
+                        assert_eq!(i, item, "the index handed to the fetch is the item's own");
+                        Ok(item)
+                    },
+                    |_, item| {
+                        delivered.push(item);
+                        Ok(())
+                    },
+                )
+                .unwrap();
+                assert_eq!(
+                    delivered, items,
+                    "{} item(s) at concurrency {}",
+                    len, concurrency
+                );
+            }
+        }
+    }
+
+    /// An error from `deliver` ends the run too, not just one from the fetch. The callers that
+    /// matter push into their own state here, and one that starts failing should stop the run
+    /// rather than have the remaining blocks fetched and handed to it anyway.
+    #[test]
+    fn a_failure_to_deliver_ends_the_run() {
+        let items: Vec<usize> = (0..8).collect();
+        let mut delivered = vec![];
+
+        let err = super::pipeline(
+            &items,
+            super::FETCH_CONCURRENCY,
+            |_, &item| Ok(item),
+            |_, item| {
+                if item == 3 {
+                    bail!("caller gave up at {}", item);
+                }
+                delivered.push(item);
+                Ok(())
+            },
+        )
+        .unwrap_err();
+
+        assert_eq!(delivered, vec![0, 1, 2], "nothing past the failure is delivered");
+        assert!(format!("{:#}", err).contains("caller gave up at 3"), "got: {:#}", err);
+    }
+
+    /// The reason this is a window and not a batch, pinned.
+    ///
+    /// An earlier version fetched in fixed chunks and waited for the whole chunk before starting
+    /// the next, which had to be reverted for indexing slower than fetching serially: at the
+    /// barrier every other worker idles until the slowest item in the chunk is done. Here the
+    /// window refills as soon as its head is delivered, so work continues past items that are
+    /// still outstanding.
+    ///
+    /// Written as a liveness check rather than a timing comparison, so it cannot go flaky: items
+    /// 1..CONCURRENCY block until released, and the test waits for item CONCURRENCY to *start*.
+    /// A batching implementation would never start it, because its chunk has not finished.
+    #[test]
+    fn work_continues_past_an_item_that_is_still_outstanding() {
+        use std::sync::{Arc, Condvar, Mutex as StdMutex};
+        use std::time::{Duration, Instant};
+
+        const CONCURRENCY: usize = 4;
+
+        let gate = Arc::new((StdMutex::new(false), Condvar::new()));
+        let started = Arc::new(StdMutex::new(Vec::<usize>::new()));
+        let gate_worker = Arc::clone(&gate);
+        let started_worker = Arc::clone(&started);
+
+        // On its own thread: the call cannot return while the gate is shut.
+        let running = std::thread::spawn(move || {
+            let items: Vec<usize> = (0..8).collect();
+            super::pipeline(
+                &items,
+                CONCURRENCY,
+                |i, &item| {
+                    started_worker.lock().unwrap().push(i);
+                    if (1..CONCURRENCY).contains(&i) {
+                        let (lock, cv) = &*gate_worker;
+                        let mut open = lock.lock().unwrap();
+                        while !*open {
+                            open = cv.wait(open).unwrap();
+                        }
+                    }
+                    Ok(item)
+                },
+                |_, _| Ok(()),
+            )
+        });
+
+        // Item 0 returns at once, freeing one slot, so the window starts item CONCURRENCY while
+        // items 1..CONCURRENCY are still blocked.
+        let deadline = Instant::now() + Duration::from_secs(10);
+        while !started.lock().unwrap().contains(&CONCURRENCY) {
+            assert!(
+                Instant::now() < deadline,
+                "item {} never started while earlier ones were outstanding: \
+                 the window is not advancing",
+                CONCURRENCY
+            );
+            std::thread::sleep(Duration::from_millis(10));
+        }
+
+        let (lock, cv) = &*gate;
+        *lock.lock().unwrap() = true;
+        cv.notify_all();
+        running.join().unwrap().unwrap();
+    }
+
+    /// A later failure must not mask an earlier one, and nothing past a failure is delivered.
+    /// Fetches run out of order, so "the first error" has to mean first in request order.
+    #[test]
+    fn the_first_error_in_request_order_is_the_one_returned() {
+        let items: Vec<usize> = (0..8).collect();
+        let mut delivered = vec![];
+
+        let err = super::pipeline(
+            &items,
+            4,
+            |_, &item| {
+                if item == 2 || item == 5 {
+                    Err(anyhow::anyhow!("item {} failed", item))
+                } else {
+                    Ok(item)
+                }
+            },
+            |_, item| {
+                delivered.push(item);
+                Ok(())
+            },
+        )
+        .unwrap_err();
+
+        assert!(format!("{:#}", err).contains("item 2 failed"), "got: {:#}", err);
+        assert_eq!(delivered, vec![0, 1], "nothing past the failure is delivered");
+    }
+
