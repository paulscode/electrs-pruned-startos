+
+#[cfg(test)]
+mod tests {
+    use super::{fold_messages, Message};
+    use std::net::{TcpListener, TcpStream};
+
+    fn request(line: &str) -> Message {
+        Message::Request(line.to_owned())
+    }
+
+    /// A client matches responses to requests by position as much as by id, so the order a batch
+    /// arrived in is the order it has to be answered in.
+    #[test]
+    fn requests_keep_their_order() {
+        let (_, lines, done) = fold_messages(vec![request("a"), request("b"), request("c")]);
+        assert_eq!(lines, vec!["a", "b", "c"]);
+        assert!(!done);
+    }
+
+    /// Everything after a disconnect goes unanswered. The socket is already shutting down, so
+    /// answering would mean doing the work -- possibly a pruned block fetch costing seconds --
+    /// for a client that cannot receive it.
+    #[test]
+    fn a_disconnect_discards_what_is_queued_behind_it() {
+        let (_, lines, done) = fold_messages(vec![
+            request("answered"),
+            Message::Done,
+            request("dropped"),
+        ]);
+        assert_eq!(lines, vec!["answered"]);
+        assert!(done);
+    }
+
+    /// A batch can open a connection and use it, and the requests that follow are still kept.
+    #[test]
+    fn a_new_connection_is_picked_up_with_its_requests() {
+        let listener = TcpListener::bind(("127.0.0.1", 0)).unwrap();
+        let stream = TcpStream::connect(listener.local_addr().unwrap()).unwrap();
+
+        let (opened, lines, done) = fold_messages(vec![Message::New(stream), request("version")]);
+        assert_eq!(opened.len(), 1);
+        assert_eq!(lines, vec!["version"]);
+        assert!(!done);
+    }
+
+    /// A client that connects and immediately hangs up is reported as done with nothing to
+    /// answer, rather than being left in the map.
+    #[test]
+    fn a_connection_that_hangs_up_at_once_is_done() {
+        let listener = TcpListener::bind(("127.0.0.1", 0)).unwrap();
+        let stream = TcpStream::connect(listener.local_addr().unwrap()).unwrap();
+
+        let (opened, lines, done) = fold_messages(vec![Message::New(stream), Message::Done]);
+        assert_eq!(opened.len(), 1);
+        assert!(lines.is_empty());
+        assert!(done);
+    }
+}
