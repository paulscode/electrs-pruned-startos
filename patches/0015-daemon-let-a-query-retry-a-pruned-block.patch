From 1bd16ff0ca988a9fd24e213fe4b34e3a510c01d2 Mon Sep 17 00:00:00 2001
From: Paul Lamb <paul@paulscode.com>
Date: Mon, 21 Sep 2026 09:35:00 -0500
Subject: [PATCH 15/15] daemon: let a query retry a pruned block

`RETRY_BUDGET_QUERY` was 10s against a default `jsonrpc_timeout` of 15s, which made
it a no-retry policy without looking like one. `retry_rpc` only checks the deadline
after an attempt returns, so the first attempt could not fail before the budget was
already spent, and every failure gave up immediately.

Underneath that, electrs stopped waiting at 15s while the proxy in front of a pruned
node keeps working on the block until its own `peer_timeout`, 30s by default. The
fetch we abandoned was often one the proxy went on to complete.

Raise the budget to 60s, which spans several attempts and reaches past the point the
proxy gives up on its own. Now that the proxy collapses duplicate requests for the
same block, a retry joins the fetch already running rather than starting another, so
this is closer to resuming the wait than repeating the work.

Safe to wait this long only because of the preceding commit: a query is answered on
its own worker, so it no longer freezes indexing and every other client -- which is
what the 10s was sized against and what its comment claimed. A failing block still
ends the whole run at its first error, so this bounds a failing query instead of
multiplying across the blocks in it.

Tested by walking the same loop `retry_rpc` runs and asserting more than one attempt
fits and that it outlasts the proxy's own deadline, with both external defaults named
so putting the budget back under either fails loudly.
---
 src/daemon.rs | 63 +++++++++++++++++++++++++++++++++++++++++++++++----
 1 file changed, 59 insertions(+), 4 deletions(-)

diff --git a/src/daemon.rs b/src/daemon.rs
index d6159c5..a18bfe8 100644
--- a/src/daemon.rs
+++ b/src/daemon.rs
@@ -375,10 +375,26 @@ pub struct Daemon {
 /// riding out a real misconfiguration — past this, failing loudly is more useful
 /// than stalling silently, and the index on disk is still valid to resume from.
 const RETRY_BUDGET_INDEXING: Duration = Duration::from_secs(300);
-/// Serving a client cannot. `handle_events` and `rpc.sync()` share one thread
-/// (`server.rs`), so a query that waits also freezes indexing and every other
-/// client. A prompt error the wallet can retry beats a five-minute freeze.
-const RETRY_BUDGET_QUERY: Duration = Duration::from_secs(10);
+/// Serving a client can afford to wait, but less.
+///
+/// This used to be 10s, sized against `handle_events` and `rpc.sync()` sharing one thread: a
+/// query that waited froze indexing and every other client, so a prompt error the wallet could
+/// retry was the better trade. `server.rs` no longer works that way -- a query is answered on a
+/// worker of its own -- so what a slow query costs is now its own client's patience and one
+/// worker, not the whole server.
+///
+/// 10s was also below `jsonrpc_timeout` (15s by default), which made it silently a no-retry
+/// policy: the first attempt could not fail before the budget was already spent, so the deadline
+/// check fired on the first error every time. Past that timeout there is a second reason to
+/// retry rather than give up. The proxy in front of a pruned node keeps working on a block for
+/// its own `peer_timeout` (30s by default) after we stop waiting, and since it now collapses
+/// duplicate requests for the same block, a retry joins that fetch instead of starting another.
+/// So a retry here is closer to resuming the wait than to repeating the work.
+///
+/// Sized to cover that: several attempts, spanning comfortably past the point where the proxy
+/// gives up on its own. A failing block still ends the whole run at the first error, so this
+/// bounds a failing query rather than multiplying across the blocks in it.
+const RETRY_BUDGET_QUERY: Duration = Duration::from_secs(60);
 const RPC_RETRY_MAX_DELAY: Duration = Duration::from_secs(30);
 
 /// How many RPC connections to the node to keep.
@@ -1042,6 +1058,45 @@ mod tests {
         assert_eq!(info.prune_height, None);
     }
 
+    /// The budget has to outlast a failed attempt, or it is a no-retry policy wearing a retry's
+    /// clothes: `retry_rpc` checks the deadline only after an attempt returns, so a budget
+    /// shorter than one attempt gives up on the first error every time. That is what 10s did.
+    #[test]
+    fn the_query_budget_outlasts_a_stalled_fetch() {
+        use std::time::Duration;
+
+        // Both defaults live outside this file: `jsonrpc_timeout_secs` is 15 in
+        // internal/config_specification.toml, and btc-rpc-proxy's `peer_timeout` is 30 in its
+        // config_spec.toml. Named here so putting the budget back under either fails loudly.
+        const ATTEMPT: Duration = Duration::from_secs(15);
+        const PROXY_PEER_TIMEOUT: Duration = Duration::from_secs(30);
+
+        let budget = super::RETRY_BUDGET_QUERY;
+        assert!(budget > ATTEMPT, "a budget under one attempt never retries");
+
+        // Walk the loop `retry_rpc` runs: attempt, check the deadline, back off, repeat.
+        let mut elapsed = Duration::ZERO;
+        let mut delay = Duration::from_secs(1);
+        let mut attempts = 0;
+        loop {
+            elapsed += ATTEMPT;
+            attempts += 1;
+            if elapsed >= budget {
+                break;
+            }
+            elapsed += delay;
+            delay *= 2;
+        }
+
+        assert!(attempts >= 2, "only {} attempt(s) fit the budget", attempts);
+        assert!(
+            elapsed > PROXY_PEER_TIMEOUT,
+            "gave up after {:?}, before the proxy stops working on the block at {:?}",
+            elapsed,
+            PROXY_PEER_TIMEOUT
+        );
+    }
+
     /// Delivery follows the request order whatever order the fetches finish in, and no more
     /// than `concurrency` run at once. Both matter: callers accumulate state through `deliver`,
     /// and the bound is what keeps a run of thousands of megabyte blocks from being held at once.
