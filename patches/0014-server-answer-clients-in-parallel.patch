+/// Answer a batch of client requests, one client at a time but several clients at once.
+///
+/// Answering a request can mean reading a block the node has pruned, which costs seconds rather
+/// than milliseconds. This runs on the same loop that drives `rpc.sync()`, so doing that one
+/// client after another lets a single wallet with deep history stall indexing and every other
+/// connected client behind it. Done a client at a time, the wait a client sees is its own.
+///
+/// Split in three, because only the middle part is safe to run in parallel:
+///   1. serial: apply connects and disconnects, which mutate the map itself, and take the
+///      clients with work out of it so each task owns one outright;
+///   2. parallel: answer each one, touching only its own `Peer` and a shared `&Rpc` -- the same
+///      split `notify_peers` above already relies on;
+///   3. serial: put back whoever survived.
+///
+/// Requests from one client stay in order and in one batch, which the protocol requires: a
+/// client matches responses to requests by position as much as by id.
 fn handle_events(rpc: &Rpc, peers: &mut HashMap<usize, Peer>, events: Vec<Event>) {
     let mut events_by_peer = HashMap::<usize, Vec<Message>>::new();
     events
         .into_iter()
         .for_each(|e| events_by_peer.entry(e.peer_id).or_default().push(e.msg));
+
+    let mut working: Vec<(Peer, Vec<String>, bool)> = vec![];
     for (peer_id, messages) in events_by_peer {
-        handle_peer_events(rpc, peers, peer_id, messages);
+        let (opened, lines, done) = fold_messages(messages);
+        for stream in opened {
+            debug!("{}: connected", peer_id);
+            peers.insert(peer_id, Peer::new(peer_id, stream));
+        }
+        // Absent from the map means an unknown peer: nothing to answer, nothing to remove.
+        if let Some(peer) = peers.remove(&peer_id) {
+            working.push((peer, lines, done));
+        }
+    }
+
+    let survivors: Vec<Peer> = working
+        .into_par_iter()
+        .filter_map(|(mut peer, lines, done)| {
+            let responses = rpc.handle_requests(&mut peer.client, &lines);
+            match peer.send(responses) {
+                Err(e) => {
+                    error!("{}: disconnecting due to {}", peer.id, e);
+                    peer.disconnect();
+                    None
+                }
+                // Already disconnected at the other end; just do not put it back.
+                Ok(()) if done => None,
+                Ok(()) => Some(peer),
+            }
+        })
+        .collect();
+
+    for peer in survivors {
+        peers.insert(peer.id, peer);
     }
 }
 
