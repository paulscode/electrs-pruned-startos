+    rpc: ClientPool,
     /// An archival node to read pruned blocks from before falling back to the usual source.
     ///
     /// A fork's two chains share every block below the split, so a second full node on the same
@@ -252,6 +323,19 @@ const RETRY_BUDGET_INDEXING: Duration = Duration::from_secs(300);
