+/// A handful of RPC connections, handed out one at a time.
+///
+/// `jsonrpc`'s transport holds a single socket behind a mutex, so concurrent calls on one `Client`
+/// queue up and finish one after another. That is invisible while everything runs on one thread,
+/// and becomes the ceiling the moment anything tries to overlap: asking for four pruned blocks at
+/// once on a shared client costs exactly what asking for them in turn costs. Each client here owns
+/// its own socket, so a checkout is a real parallel slot.
+///
+/// Sized rather than unbounded on purpose. Every slot in use can become peer connections opened by
+/// the proxy on the other side, so this is the throttle for the whole chain, and it is better set
+/// here — where the work is issued — than discovered downstream.
+pub(crate) struct Pool<T> {
+    ready: crossbeam_channel::Receiver<T>,
+    idle: crossbeam_channel::Sender<T>,
+}
+
+pub(crate) type ClientPool = Pool<Client>;
+
+impl<T> Pool<T> {
+    fn new(size: usize, mut make: impl FnMut() -> Result<T>) -> Result<Self> {
+        let size = size.max(1);
+        let (idle, ready) = crossbeam_channel::bounded(size);
+        for _ in 0..size {
+            idle.send(make()?)
+                .expect("the receiver is held by the pool being built");
+        }
+        Ok(Pool { ready, idle })
+    }
+
+    /// Takes a connection, waiting for one if they are all busy.
+    ///
+    /// Waiting is the intended behaviour rather than a fallback: the alternative is opening
+    /// connections without limit under load, which moves the problem to the node.
+    fn get(&self) -> Pooled<'_, T> {
+        let client = self
+            .ready
+            .recv()
+            .expect("the sender is held by the pool, so this cannot disconnect");
+        Pooled {
+            client: Some(client),
+            idle: &self.idle,
+        }
+    }
+}
+
+pub(crate) struct Pooled<'a, T> {
+    client: Option<T>,
+    idle: &'a crossbeam_channel::Sender<T>,
+}
+
+impl<T> std::ops::Deref for Pooled<'_, T> {
+    type Target = T;
+    fn deref(&self) -> &T {
+        self.client
+            .as_ref()
+            .expect("taken only by Drop, which consumes self")
+    }
+}
+
+impl<T> Drop for Pooled<'_, T> {
+    fn drop(&mut self) {
+        if let Some(client) = self.client.take() {
+            // Returned even after a failed call. A connection that erred is still usable: the
+            // transport drops its socket on error and opens a fresh one on the next request.
+            let _ = self.idle.send(client);
+        }
+    }
+}
+
