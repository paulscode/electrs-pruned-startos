+    /// The pool hands out each connection to one caller at a time and takes it back afterwards.
+    /// Without that, "four slots" would mean four names for the same socket.
+    #[test]
+    fn the_pool_hands_out_each_connection_once() {
+        let pool = super::Pool::new(3, {
+            let mut next = 0;
+            move || {
+                next += 1;
+                Ok(next)
+            }
+        })
+        .unwrap();
+
+        let a = pool.get();
+        let b = pool.get();
+        let c = pool.get();
+        let mut held = vec![*a, *b, *c];
+        held.sort();
+        assert_eq!(held, vec![1, 2, 3], "three distinct connections");
+
+        drop(b);
+        assert_eq!(*pool.get(), 2, "a returned connection is handed out again");
+    }
+
+    /// A connection is returned even when the call that borrowed it failed, because the transport
+    /// opens a fresh socket on its next request anyway. Losing one per error would drain the pool.
+    #[test]
+    fn a_connection_comes_back_after_an_error() {
+        let pool = super::Pool::new(1, || Ok(7u8)).unwrap();
+        {
+            let borrowed = pool.get();
+            let _: Result<(), ()> = Err(());
+            assert_eq!(*borrowed, 7);
+        }
+        assert_eq!(*pool.get(), 7, "still available after a failed borrow");
+    }
+
+    /// Asking for more than exist waits rather than opening another. The wait is the throttle:
+    /// every slot in use can become peer connections on the far side of the proxy.
+    #[test]
+    fn the_pool_blocks_when_every_connection_is_busy() {
+        use std::sync::Arc;
+        use std::time::Duration;
+
+        let pool = Arc::new(super::Pool::new(1, || Ok(1u8)).unwrap());
+        let held = pool.get();
+
+        let waiter = {
+            let pool = Arc::clone(&pool);
+            std::thread::spawn(move || {
+                let _got = pool.get();
+                true
+            })
+        };
+
+        std::thread::sleep(Duration::from_millis(50));
+        assert!(!waiter.is_finished(), "it should still be waiting");
+
+        drop(held);
+        assert!(waiter.join().unwrap(), "and proceed once one is free");
+    }
