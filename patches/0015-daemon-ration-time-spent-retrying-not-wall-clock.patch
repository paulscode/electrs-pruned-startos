+    /// Time spent *succeeding* must not consume the allowance.
+    ///
+    /// This is the regression that made the first attempt at a shared allowance wrong. It gave
+    /// serving one deadline from the start of the run, so a query that had been fetching happily
+    /// for longer than the allowance hit its first transient error already past that deadline and
+    /// gave up without a single retry. On a deep history over Tor, running longer than the
+    /// allowance is ordinary, so it turned a stale peer connection into the very "failed to fetch
+    /// history" this change exists to remove.
+    #[test]
+    fn a_long_run_that_is_working_keeps_its_full_allowance() {
+        use std::sync::atomic::AtomicU64;
+        use std::time::Duration;
+
+        let spent_nanos = AtomicU64::new(0);
+        let retry = super::Retry::Shared {
+            spent_nanos: &spent_nanos,
+            budget: Duration::from_secs(60),
+        };
+
+        // However long the run has been going, nothing has been retried yet.
+        assert!(
+            !retry.exhausted(Duration::ZERO),
+            "a run that has only succeeded has spent nothing"
+        );
+        assert!(
+            !retry.exhausted(Duration::from_secs(59)),
+            "so it still has essentially the whole allowance to retry with"
+        );
+    }
+
+    /// Retrying is charged, and the charge carries to the rest of the run. Without that each stage
+    /// -- prune height, heights, then every block -- could spend the allowance over again, which
+    /// is the whole reason it is shared.
+    #[test]
+    fn retrying_is_charged_across_the_run() {
+        use std::sync::atomic::AtomicU64;
+        use std::time::Duration;
+
+        let spent_nanos = AtomicU64::new(0);
+        let retry = super::Retry::Shared {
+            spent_nanos: &spent_nanos,
+            budget: Duration::from_secs(60),
+        };
+
+        retry.charge(Duration::from_secs(45));
+        assert!(
+            !retry.exhausted(Duration::from_secs(10)),
+            "45 spent plus 10 more is still inside 60"
+        );
+        assert!(
+            retry.exhausted(Duration::from_secs(15)),
+            "45 spent plus 15 more is not"
+        );
+
+        retry.charge(Duration::from_secs(15));
+        assert!(
+            retry.exhausted(Duration::ZERO),
+            "once it is gone a later stage gives up at once rather than starting over"
+        );
+    }
+
+    /// Indexing keeps a fresh allowance per call, and charging one call must not shorten the next.
+    /// A 2000-block batch over Tor outlasts any sane allowance, so the last blocks in a batch have
+    /// to be as able to ride out a blip as the first.
+    #[test]
+    fn indexing_does_not_carry_a_charge_between_calls() {
+        use std::time::Duration;
+
+        let retry = super::Retry::PerCall {
+            budget: Duration::from_secs(300),
+        };
+
+        retry.charge(Duration::from_secs(299));
+        assert!(
+            !retry.exhausted(Duration::from_secs(299)),
+            "each call starts its allowance afresh"
+        );
+        assert!(
+            retry.exhausted(Duration::from_secs(300)),
+            "but one call still cannot exceed it"
+        );
+    }
+
+    /// The allowance has to be worth more than one attempt, and it has to keep trying past the
+    /// point the proxy gives up on its own.
+    ///
+    /// If it is worth less than an attempt it is a no-retry policy wearing a retry's clothes,
+    /// which is what 10s against a 15s call timeout was. And the reason to keep going past 30s is
+    /// that the proxy works on the block for its own `peer_timeout` after we have stopped waiting
+    /// and caches the result, so an attempt starting after that point finds it already there.
+    #[test]
+    fn the_query_allowance_outlasts_a_stalled_fetch() {
+        use std::time::Duration;
+
+        // Both defaults live outside this file: `jsonrpc_timeout_secs` is 15 in
+        // internal/config_specification.toml, and btc-rpc-proxy's `peer_timeout` is 30 in its
+        // config_spec.toml. Named here so putting the allowance back under either fails loudly.
+        const ATTEMPT: Duration = Duration::from_secs(15);
+        const PROXY_PEER_TIMEOUT: Duration = Duration::from_secs(30);
+
+        let budget = super::RETRY_BUDGET_QUERY;
+        assert!(budget > ATTEMPT, "an allowance under one attempt never retries");
+
+        // Walk what `retry_rpc` actually does against a call that keeps failing: the allowance is
+        // measured from the *first failure*, so the opening attempt is not charged to it.
+        let retry = super::Retry::PerCall { budget };
+        let mut since_first_failure = Duration::ZERO;
+        let mut from_call_start = ATTEMPT; // the opening attempt
+        let mut delay = Duration::from_secs(1);
+        let mut attempt_starts = vec![Duration::ZERO];
+
+        loop {
+            if retry.exhausted(since_first_failure) {
+                break;
+            }
+            // Back off, then attempt again.
+            since_first_failure += delay;
+            from_call_start += delay;
+            attempt_starts.push(from_call_start);
+            since_first_failure += ATTEMPT;
+            from_call_start += ATTEMPT;
+            delay = std::cmp::min(delay * 2, super::RPC_RETRY_MAX_DELAY);
+        }
+
+        assert!(
+            attempt_starts.len() >= 2,
+            "only {} attempt(s) fit the allowance",
+            attempt_starts.len()
+        );
+        assert!(
+            attempt_starts.iter().any(|t| *t > PROXY_PEER_TIMEOUT),
+            "every attempt started within {:?}, so none can pick up what the proxy finished: {:?}",
+            PROXY_PEER_TIMEOUT,
+            attempt_starts
+        );
+    }
+
     /// Delivery follows the request order whatever order the fetches finish in, and no more
     /// than `concurrency` run at once. Both matter: callers accumulate state through `deliver`,
     /// and the bound is what keeps a run of thousands of megabyte blocks from being held at once.
