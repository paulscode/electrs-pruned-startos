+    /// A transient failure must be retried. This is the outage in one line: the allowance used to
+    /// be spent before the first attempt could fail, so a single blip ended the whole query.
+    #[test]
+    fn a_transient_failure_is_retried() {
+        use std::cell::Cell;
+        use std::sync::atomic::{AtomicU64, Ordering};
+        use std::time::Duration;
+
+        let spent_nanos = AtomicU64::new(0);
+        let retry = super::Retry::Shared {
+            spent_nanos: &spent_nanos,
+            budget: Duration::from_secs(60),
+        };
+        let calls = Cell::new(0);
+
+        let got = super::retry_with(
+            "flaky call",
+            retry,
+            Duration::from_millis(1),
+            &|| Ok(()),
+            || {
+                calls.set(calls.get() + 1);
+                if calls.get() < 3 {
+                    bail!("not yet")
+                }
+                Ok("value")
+            },
+        )
+        .expect("it should have retried its way to a value");
+
+        assert_eq!(got, "value");
+        assert_eq!(calls.get(), 3, "one attempt plus two retries");
+        assert!(
+            spent_nanos.load(Ordering::Relaxed) > 0,
+            "the retrying is charged to the run"
+        );
+    }
+
+    /// A call that works first time is free: nothing slept, nothing charged.
+    #[test]
+    fn a_call_that_works_first_time_costs_nothing() {
+        use std::sync::atomic::{AtomicU64, Ordering};
+        use std::time::{Duration, Instant};
+
+        let spent_nanos = AtomicU64::new(0);
+        let retry = super::Retry::Shared {
+            spent_nanos: &spent_nanos,
+            budget: Duration::from_secs(60),
+        };
+
+        let started = Instant::now();
+        let got = super::retry_with(
+            "clean call",
+            retry,
+            Duration::from_secs(30), // would be obvious if it were ever waited on
+            &|| Ok(()),
+            || Ok(7),
+        )
+        .unwrap();
+
+        assert_eq!(got, 7);
+        assert_eq!(spent_nanos.load(Ordering::Relaxed), 0, "nothing was retried");
+        assert!(started.elapsed() < Duration::from_secs(5), "and nothing was slept");
+    }
+
+    /// Once the allowance is gone, a later call gives up on its first failure rather than starting
+    /// the whole backoff over. That is what stops a run spending the allowance once per stage.
+    #[test]
+    fn a_spent_allowance_gives_up_at_once() {
+        use std::cell::Cell;
+        use std::sync::atomic::AtomicU64;
+        use std::time::Duration;
+
+        let spent_nanos = AtomicU64::new(0);
+        let retry = super::Retry::Shared {
+            spent_nanos: &spent_nanos,
+            budget: Duration::from_secs(60),
+        };
+        retry.charge(Duration::from_secs(60)); // an earlier stage used it all
+
+        let calls = Cell::new(0);
+        let err = super::retry_with(
+            "later stage",
+            retry,
+            Duration::from_millis(1),
+            &|| Ok(()),
+            || -> anyhow::Result<()> {
+                calls.set(calls.get() + 1);
+                bail!("still down")
+            },
+        )
+        .unwrap_err();
+
+        assert_eq!(calls.get(), 1, "tried once and stopped");
+        assert!(
+            format!("{:#}", err).contains("still failing after"),
+            "the give-up reason travels with it: {:#}",
+            err
+        );
+        assert!(format!("{:#}", err).contains("still down"), "as does the cause");
+    }
+
+    /// A shutdown arriving mid-backoff is honoured rather than waited out, and it stops the retry
+    /// loop rather than being swallowed as another transient failure.
+    #[test]
+    fn an_interrupt_during_backoff_stops_the_loop() {
+        use std::cell::Cell;
+        use std::time::Duration;
+
+        let retry = super::Retry::PerCall {
+            budget: Duration::from_secs(60),
+        };
+        let calls = Cell::new(0);
+
+        let err = super::retry_with(
+            "interrupted call",
+            retry,
+            Duration::from_millis(1),
+            &|| -> anyhow::Result<()> { bail!("shutting down") },
+            || -> anyhow::Result<()> {
+                calls.set(calls.get() + 1);
+                bail!("down")
+            },
+        )
+        .unwrap_err();
+
+        assert_eq!(calls.get(), 1, "it did not attempt again after the interrupt");
+        assert!(
+            format!("{:#}", err).contains("shutting down"),
+            "the interrupt is the reason, not the RPC failure: {:#}",
